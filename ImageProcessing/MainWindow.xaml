<Window x:Class="ImageProcessing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImageProcessing"
        mc:Ignorable="d"
        Title="0%" Height="450" Width="800">
    <Grid>
        <DockPanel LastChildFill="True">
            <Menu Height="25" DockPanel.Dock="Top" FontWeight="Bold" BorderThickness="1" BorderBrush="Black">
                <MenuItem x:Name="menuFile" Header="File">
                    <MenuItem Header="Open" Click="MenuItem_Click" ></MenuItem>
                </MenuItem>
            </Menu>
            <ScrollBar x:Name="scrollBar" DockPanel.Dock="Right" BorderThickness="1" BorderBrush="Black" Scroll="ScrollBar_Scroll" Maximum="100"/>
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <Image x:Name="imageBox"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
